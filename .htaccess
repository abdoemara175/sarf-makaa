# ==========================================================================
# Production Web Server Configuration (.htaccess)
# Project: Makkah Sewage & Septic Tank Cleaning Services
# ==========================================================================

# 1. Enable Rewrite Engine & UTF-8 Encoding
<IfModule mod_rewrite.c>
    RewriteEngine On
    AddDefaultCharset UTF-8
</IfModule>

# 2. Correct MIME Types Configuration
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json .map
    AddType application/xml .xml
    AddType text/plain .txt
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/svg+xml .svg .svgz
</IfModule>

# 3. GZIP & Brotli Compression for Superfast Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 4. Security & MIME Type Sniffing Defense Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Browser Caching Control Rules
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML Documents
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS & JavaScript (Handled by ?v=1.0.0 cache busting)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Images & Media
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
